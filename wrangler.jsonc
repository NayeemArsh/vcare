{
  "name": "v-care-telegram",
  "main": "V-Care_Telegram.mjs",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    { "binding": "STATE", "id": "3b04ac24997341449fa82775ef0646ca" }
  ],
  "triggers": {
    "crons": [
      "*/3 3-10 * * 1-5"
    ]
  },
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true }
  }
}
